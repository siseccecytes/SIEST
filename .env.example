# ============================================================
#  Copia este archivo como  .env  en el servidor y rellena los valores.
#  NUNCA subas el .env real al repositorio.
# ============================================================

# Dominio publico. En el servidor de QA dejalo asi.
# Para probar en local sin certificado, usa:  SITE_ADDRESS=:80
SITE_ADDRESS=siest.qa.cecyte.edu.mx

# Contraseña de la base de datos MySQL (usuario root)
DB_PASSWORD=pon-aqui-una-contraseña-segura

# Secreto para los tokens JWT (minimo 32 caracteres aleatorios)
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-de-minimo-32-caracteres
JWT_EXPIRATION=86400000

# Origenes permitidos para CORS (normalmente el dominio publico)
CORS_ALLOWED_ORIGINS=https://siest.qa.cecyte.edu.mx
