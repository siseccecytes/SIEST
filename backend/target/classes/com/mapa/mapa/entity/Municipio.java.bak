package com.mapa.mapa.entity;

import jakarta.persistence.*;
import lombok.Data;

@Entity
@Data
@Table(name = "directorio_cecyte")
public class DirectorioCecyte {
    @Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    private Long id;
    
    private String colegio;
    private String cct;
    private String plantel;
    private String direccion;
    
    @Column(name = "municipio_alcaldia")
    private String municipioAlcaldia;
    
    @Column(name = "colonia_cp")
    private String coloniaCp;
    
    @Column(name = "MUNICIPIO / ALCALDIA")
    private String municipio;
    
    private String columna1;
    
    private Double latitud;
    private Double longitud;
}
