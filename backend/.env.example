# Copia este archivo como .env y llena los valores reales
# NUNCA subas el .env al repositorio

DB_URL=jdbc:mysql://localhost:3306/indicadores_educativos?useSSL=false&serverTimezone=UTC
DB_USERNAME=tu_usuario_bd
DB_PASSWORD=tu_password_bd

# Mínimo 32 caracteres, usa caracteres aleatorios
JWT_SECRET=cambia-esto-por-un-secreto-seguro-de-al-menos-32-caracteres!!
JWT_EXPIRATION=86400000

# Orígenes permitidos separados por coma (sin espacios)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Rutas de carpetas de PDFs en el servidor
PDFS_ANEXOS=/ruta/en/servidor/anexos
PDFS_OFERTA=/ruta/en/servidor/oferta
