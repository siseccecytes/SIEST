package com.mapa.mapa.controller;

import com.mapa.mapa.dto.PlantelDTO;
import com.mapa.mapa.service.PlantelService;
import lombok.RequiredArgsConstructor;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;
import java.util.List;

@RestController
@RequestMapping("/api/planteles")
@RequiredArgsConstructor
@CrossOrigin(origins = "*")
public class PlantelController {
    private final PlantelService plantelService;
    
    @GetMapping("/estado/{estadoId}")
    public ResponseEntity<List<PlantelDTO>> getPlantelsByEstado(@PathVariable Long estadoId) {
        return ResponseEntity.ok(plantelService.getPlantelsByEstado(estadoId));
    }
    
    @GetMapping("/municipio/{municipioId}")
    public ResponseEntity<List<PlantelDTO>> getPlantelsByMunicipio(@PathVariable Long municipioId) {
        return ResponseEntity.ok(plantelService.getPlantelsByMunicipio(municipioId));
    }
    
    @GetMapping("/{id}")
    public ResponseEntity<PlantelDTO> getPlantelById(@PathVariable Long id) {
        return ResponseEntity.ok(plantelService.getPlantelById(id));
    }
}
